	partition dCalendario = calculated
		mode: import
		source =
				
				ADDCOLUMNS(
				    CALENDAR(DATE(2016,01,01),DATE(2022,12,31)),
				    "ANO", YEAR([Date]),
				    "MES_NUMERO", MONTH([Date]),
				    "NOME_MES", FORMAT([Date],"MMMM","pt-BR"),
				    "ANO_MES", FORMAT([Date], "YYYY-MM")
				)

	annotation PBI_Id = 82df882756784b1d9f9d0f97834d6759

