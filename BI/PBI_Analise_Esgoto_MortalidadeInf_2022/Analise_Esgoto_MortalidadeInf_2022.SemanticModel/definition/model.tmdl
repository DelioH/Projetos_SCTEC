model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["F_NASCIMENTOS","F_OBITOS","F_ESGOTO_2022","D_MUNICIPIOS_2022","MEDIDAS","F_OBITOS_2021","F_OBITOS_2020","F_OBITOS_2019","F_OBITOS_2018","F_OBITOS_2017","F_OBITOS_2016","F_NASCIMENTOS_2021","F_NASCIMENTOS_2020","F_NASCIMENTOS_2019","F_NASCIMENTOS_2018","F_NASCIMENTOS_2017","F_NASCIMENTOS_2016"]

annotation PBI_ProTooling = ["DevMode"]

ref table F_NASCIMENTOS
ref table F_OBITOS
ref table F_ESGOTO_2022
ref table D_MUNICIPIOS_2022
ref table MEDIDAS
ref table F_OBITOS_2021
ref table F_OBITOS_2020
ref table F_OBITOS_2019
ref table F_OBITOS_2018
ref table F_OBITOS_2017
ref table F_OBITOS_2016
